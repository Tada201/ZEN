{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zen (Dev)",
  "identifier": "com.zen.app.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zen (Dev)",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "visible": false
      },
      {
        "label": "prompt",
        "title": "Zen Confirmation (Dev)",
        "width": 460,
        "height": 320,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "confirmation.html"
      },
      {
        "label": "splashscreen",
        "title": "Zen Startup (Dev)",
        "width": 780,
        "height": 460,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "url": "splashscreen.html",
        "visible": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/VISUALIZATION_GUIDE.md",
      "resources/agents/*.json"
    ]
  },
  "plugins": {
    "zen": {
      "profile": "dev"
    }
  }
}
